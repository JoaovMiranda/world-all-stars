{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WEB_DEV=1 tsx watch --clear-screen=false --exclude '../web/**' src/main.ts",
    "start": "NODE_ENV=production node dist/main.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@hono/node-server": "2.1.6",
    "@was/db": "workspace:*",
    "@was/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
