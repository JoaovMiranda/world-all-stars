# World All Stars: copy to `.env` (gitignored) at the repo root. The server loads it on boot (process.loadEnvFile;
# variables already set in the shell win). Every variable is optional in dev: `pnpm dev` runs without a .env.
# NEVER commit real secrets.

# ── Server ──
# PORT=8787
# HOST=127.0.0.1
# Public origin (canonical/og links, sitemap). Default http://localhost:<PORT>.
# PUBLIC_URL=http://localhost:8787
# CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# APP_TIME_ZONE=America/Sao_Paulo
# SSR_CACHE_TTL_SECONDS=60
# A page render slower than this answers 503 (ms).
# SSR_TIMEOUT_MS=10000
# Largest request body accepted by /api (KB).
# BODY_LIMIT_KB=64
# Image proxy /img/wm (Wikimedia thumbnails from our origin): in-process cache (MB, 0 = none) and upstream timeout (ms).
# IMAGE_PROXY_CACHE_MB=64
# IMAGE_PROXY_TIMEOUT_MS=8000
# RATE_LIMIT_ENABLED=1
# LOG_REQUESTS=1
# Request log format (json in production, text in dev) and the slow-request threshold logged as warn (ms).
# LOG_FORMAT=text
# SLOW_REQUEST_MS=1000
# OpenTelemetry traces (off unless set): OTLP/HTTP collector, or OTEL_TRACES_EXPORTER=console to print spans.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=world-all-stars
# MIGRATE_ON_BOOT=1
# WEB_DIST_DIR=apps/web/dist
# MIGRATIONS_DIR=
# Salt of the ip_hash. REQUIRED in production (16+ random characters; generate: openssl rand -base64 24).
# IP_HASH_SALT=

# ── Database ── (unset = embedded PGlite in .data/pglite)
# DATABASE_URL=postgres://user:password@localhost:5432/was
# Postgres pool per process: connections, statement timeout and wait for a connection (ms).
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_CONNECTION_TIMEOUT_MS=5000
# PGLITE_DATA_DIR=.data/pglite

# ── Sign-in: Better Auth + Google ──
# Origin Better Auth builds its URLs from. Google redirect URI = <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:8787
# 32+ random characters (signs the session cookie, encrypts OAuth tokens). REQUIRED in production. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID ("Web application").
# Both empty = Google sign-in disabled (the login dialog says "Login com Google não configurado").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated e-mails promoted to admin on boot and on first sign-in (audited as role_changed).
ADMIN_EMAILS=
# Dev session switcher (demo reader/admin without Google). Default 1 outside production; FORBIDDEN in production.
AUTH_SIMULATED=1

# ── Web (Vite; read by `pnpm dev:api` / `pnpm build`) ──
# VITE_DATA_SOURCE=http
# VITE_API_BASE_URL=

# ── Production / Docker / CI ──
# NODE_ENV=production (`pnpm start`, the Docker image) refuses to boot without IP_HASH_SALT and BETTER_AUTH_SECRET,
# and with AUTH_SIMULATED=1: use AUTH_SIMULATED=0 (or remove it) in a production env file.
# Docker: `docker run --env-file .env.production -v was-data:/data -p 8787:8787 world-all-stars` (README, "CI e Docker").
# The image already sets NODE_ENV=production HOST=0.0.0.0 PORT=8787 WEB_DIST_DIR=/app/web MIGRATIONS_DIR=/app/migrations
# PGLITE_DATA_DIR=/data/pglite; set PUBLIC_URL/BETTER_AUTH_URL/CORS_ORIGINS to the public origin. `.env*` never enters
# the image (.dockerignore). CI (.github/workflows/ci.yml) uses dummy secrets only, in scripts/ci/smoke.sh.
