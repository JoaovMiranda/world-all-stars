{
  "name": "world-all-stars",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "VITE_DATA_SOURCE=http turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "start": "NODE_ENV=production node --import ./apps/server/dist/instrumentation.js apps/server/dist/main.js",
    "db:generate": "pnpm --filter @was/db generate",
    "db:migrate": "pnpm --filter @was/db migrate",
    "db:seed": "pnpm --filter @was/db seed",
    "db:reset": "pnpm --filter @was/db reset",
    "db:cleanup": "pnpm --filter @was/db cleanup",
    "perf:budget": "node scripts/ci/bundle-budget.mjs",
    "perf:lighthouse": "npx -y @lhci/cli@0.16.0 autorun",
    "fixtures:export": "node scripts/fixtures/export-prototype-fixtures.mjs",
    "translations:content": "node scripts/translations/content-translations.mjs",
    "lint:a11y": "pnpm --filter web lint:a11y",
    "ingest": "pnpm --filter @was/ingest ingest",
    "ingest:report": "pnpm --filter @was/ingest ingest report",
    "ingest:worker": "pnpm --filter @was/ingest ingest worker",
    "ingest:identity-eval": "pnpm --filter @was/ingest ingest identity-eval",
    "catalog:sports": "node scripts/catalog/build-sports-catalog.mjs",
    "og:default": "node scripts/og/build-default-og.mjs",
    "rankings:calculate": "pnpm --filter server exec tsx src/cli/rankings.cli.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dup": "jscpd apps packages",
    "deadcode": "knip",
    "e2e": "pnpm --filter web exec playwright test",
    "load": "k6 run scripts/load/smoke.js",
    "scan:mixed": "node scripts/scan/mixed-declarations.mjs",
    "scan:language": "node scripts/scan/non-english.mjs",
    "lint:language": "node scripts/scan/non-english.mjs --fail",
    "lint:declarations": "node scripts/scan/declaration-rules.mjs --fail",
    "docker:up": "docker compose up -d app",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:reset": "docker compose stop app && rm -rf .data/pglite-docker && docker compose up -d app",
    "docker:pg": "docker compose --profile postgres up -d postgres",
    "docker:worker": "docker compose --profile worker up -d ingest-worker",
    "docker:worker:logs": "tail -f data/review/collect.log",
    "collect:sample": "node scripts/ingest/sample-athletes.mjs",
    "collect:bg": "caffeinate -i nohup pnpm ingest collect --update --priority > data/review/collect.log 2>&1 &"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "jscpd": "5.4.3",
    "knip": "6.47.0",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  }
}
