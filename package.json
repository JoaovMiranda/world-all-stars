{
  "name": "world-all-stars",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "VITE_DATA_SOURCE=http turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "start": "NODE_ENV=production node --import ./apps/server/dist/instrumentation.js apps/server/dist/main.js",
    "db:generate": "pnpm --filter @was/db generate",
    "db:migrate": "pnpm --filter @was/db migrate",
    "db:seed": "pnpm --filter @was/db seed",
    "db:reset": "pnpm --filter @was/db reset",
    "db:cleanup": "pnpm --filter @was/db cleanup",
    "perf:budget": "node scripts/ci/bundle-budget.mjs",
    "perf:lighthouse": "npx -y @lhci/cli@0.16.0 autorun",
    "fixtures:export": "node scripts/fixtures/export-prototype-fixtures.mjs",
    "translations:content": "node scripts/translations/content-translations.mjs",
    "lint:a11y": "pnpm --filter web lint:a11y",
    "ingest": "pnpm --filter @was/ingest ingest",
    "ingest:report": "pnpm --filter @was/ingest ingest report",
    "ingest:worker": "pnpm --filter @was/ingest ingest worker",
    "ingest:identity-eval": "pnpm --filter @was/ingest ingest identity-eval",
    "catalog:sports": "node scripts/catalog/build-sports-catalog.mjs",
    "rankings:calculate": "pnpm --filter server exec tsx src/cli/rankings.cli.ts"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  }
}
