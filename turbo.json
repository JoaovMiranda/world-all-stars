{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "VITE_*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "VITE_*",
        "API_PROXY_TARGET",
        "DATABASE_URL",
        "PGLITE_DATA_DIR",
        "PORT",
        "HOST",
        "CORS_ORIGINS",
        "IP_HASH_SALT",
        "RATE_LIMIT_ENABLED",
        "LOG_REQUESTS",
        "MIGRATE_ON_BOOT"
      ]
    },
    "test": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    }
  }
}
